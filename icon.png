<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body style="background:#090d16; display:flex; justify-content:center; align-items:center; height:100vh; margin:0;">
    <canvas id="ic" width="512" height="512"></canvas>
    <script>
        const c = document.getElementById('ic'), ctx = c.getContext('2d');
        // Nền bo góc chuẩn app icon
        ctx.fillStyle = '#ea580c'; ctx.beginPath(); ctx.roundRect(0, 0, 512, 512, 110); ctx.fill();
        // Vòng tròn radar công nghệ
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.4)'; ctx.lineWidth = 12; ctx.beginPath(); ctx.arc(256, 256, 180, 0, Math.PI * 2); ctx.stroke();
        // Lưới tọa độ oscilloscope
        ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 4;
        ctx.beginPath(); ctx.moveTo(256, 60); ctx.lineTo(256, 452); ctx.moveTo(60, 256); ctx.lineTo(452, 256); ctx.stroke();
        // Sóng sin đặc trưng dao động ký màu xanh neon
        ctx.strokeStyle = '#38bdf8'; ctx.lineWidth = 24; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
        ctx.beginPath();
        ctx.moveTo(80, 256);
        ctx.bezierCurveTo(140, 100, 190, 400, 256, 256);
        ctx.bezierCurveTo(320, 110, 370, 410, 432, 256);
        ctx.stroke();
        // Chữ FOX-LAB nhỏ phía dưới
        ctx.fillStyle = '#ffffff'; ctx.font = 'bold 42px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText("FOX-LAB", 256, 430);
    </script>
</body>
</html>
